[Unit]
Description=ClawdBot - Telegram AI Assistant
After=network.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%HOME%/ClawdBot-V1
Environment=NODE_ENV=production
EnvironmentFile=%HOME%/ClawdBot-V1/.env
ExecStart=/usr/bin/moltbot gateway --port 18789
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawdbot

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%HOME%/.clawdbot %HOME%/ClawdBot-V1

[Install]
WantedBy=multi-user.target
