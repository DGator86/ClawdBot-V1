{
  "agents": {
    "defaults": {
      "workspace": "~/clawd",
      "model": {
        "primary": "openai/gpt-4o"
      },
      "thinkingDefault": "low"
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "identity": {
          "name": "ClawdBot",
          "theme": "crypto trading assistant",
          "emoji": "🤖"
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["./skills"]
    }
  }
}
