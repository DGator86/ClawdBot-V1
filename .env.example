# ClawdBot Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# REQUIRED: Telegram
# ==============================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==============================================
# REQUIRED: AI Provider (choose one)
# ==============================================

# OpenAI API Key (used by ClawdBot for reasoning)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================
# REQUIRED: Kalshi API (for Yoshi-Bot signals)
# ==============================================

# Kalshi API Key ID (from https://kalshi.com/account/api)
KALSHI_KEY_ID=your_kalshi_key_id_here

# Kalshi RSA Private Key (PEM format)
# Store the key in a file and reference it, OR paste the full PEM inline.
# For inline: replace newlines with \n (the client handles PEM parsing).
# Example file method: KALSHI_PRIVATE_KEY_FILE=/home/root/.kalshi/private_key.pem
KALSHI_PRIVATE_KEY=your_kalshi_private_key_here

# ==============================================
# OPTIONAL: DigitalOcean VPS Management
# ==============================================

# DigitalOcean Personal Access Token (for VPS health monitoring)
# DIGITALOCEAN_TOKEN=your_do_token_here

# VPS IP address (for health checks via monitor_vps.py)
# VPS_IP=165.245.140.115

# ==============================================
# OPTIONAL: Additional Services
# ==============================================

# ElevenLabs API Key (for voice features)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Telegram Chat ID (for alert notifications)
# TELEGRAM_CHAT_ID=your_chat_id_here
